NODE_ENV=development
HOST=127.0.0.1
PORT=3100
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json
AUTH_RECOVERY_PEPPER=generate-at-least-32-random-characters
AUTH_COLLECTION_PREFIX=staging_v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional; required only when Expo Enhanced Push Security is enabled.
# EXPO_PUSH_ACCESS_TOKEN=replace-with-expo-access-token
