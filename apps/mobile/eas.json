{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "node": "20.11.0"
    },
    "production-apk": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production-apk",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815637042",
        "appleId": "bakrisabagh@hotmail.com",
        "appleTeamId": "FARTZT93HT"
      }
    }
  }
}