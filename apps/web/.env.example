# API Configuration
NEXT_PUBLIC_API_URL=https://staging.g000st.com
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Firebase web configuration (public client identifiers, not service-account credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://replace-with-project-default-rtdb.firebaseio.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ADMIN=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_SOCIAL=true
